# Copy to .env (git-ignored) and fill in. Read by relay/relay.py and, at build time,
# by firmware/ and menu/ (settings are compiled into the StopWatch programs).

# Shared secret between the StopWatch and the relay (HTTP header / BLE handshake).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
RELAY_TOKEN=

# Firmware: the Wi-Fi the StopWatch joins and the relay it talks to over HTTP.
WIFI_SSID=
WIFI_PASS=
RELAY_URL=http://192.168.1.10:8765
# How the StopWatch reaches the relay: auto (Wi-Fi, BLE when that fails), wifi, or ble.
# TRANSPORT=auto

# The name of the voice chat entry in the launcher menu. The voice app's BLE device
# name is <AVATAR_NAME>-StopWatch.
# AVATAR_NAME=Avatar

# Relay: Claude Code session (optional; defaults shown).
# CLAUDE_MODEL=claude-haiku-5-5
# "default" refuses anything that needs a confirmation. "bypassPermissions" runs every
# tool without asking: anyone who knows RELAY_TOKEN can then run commands on this Mac.
# CLAUDE_PERMISSION_MODE=default
# Working directory of the session (default: relay/workspace).
# CLAUDE_CWD=~/projects
# Extra folders the session may use, comma separated.
# CLAUDE_ADD_DIRS=~/notes
# An output style from ~/.claude/output-styles/ (the rest of your user settings is not loaded).
# CLAUDE_OUTPUT_STYLE=
# Replaces the relay's default prompt; it is appended to Claude Code's own system prompt.
# One line; \n becomes a newline.
# SYSTEM_PROMPT="..."

# Relay: speech recognition and port.
# WHISPER_MODEL=mlx-community/whisper-small-mlx
# RELAY_PORT=8765
